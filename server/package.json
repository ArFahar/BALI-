{
  "name": "@localnorm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "eval": "tsx src/scripts/eval.ts",
    "tone-probe": "tsx src/scripts/tone-probe.ts",
    "audit:retrieval": "tsx src/scripts/retrieval-audit.ts",
    "test": "vitest run",
    "kb:extract": "python -I ../knowledge/pipeline/stage1_extract.py",
    "kb:structure": "python -I ../knowledge/pipeline/stage2_structure.py",
    "kb:chunk": "node ../knowledge/pipeline/stage3_chunk.mjs",
    "kb:embed": "node ../knowledge/pipeline/stage4_embed.mjs",
    "kb:load": "node ../knowledge/pipeline/stage5_load.mjs",
    "kb:build": "npm run kb:extract && npm run kb:structure && npm run kb:chunk && npm run kb:embed"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.6",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
