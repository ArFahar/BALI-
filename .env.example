# LocalNorm AI — copy to server/.env and fill in. Never commit real values.

# --- Server ---
PORT=8787
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGIN=http://localhost:5173

# --- LLM (optional) ---
# sumopod | gemini | none. Auto-selects SumoPod when SUMOPOD_API_KEY is set, then Gemini, otherwise extractive.
LLM_PROVIDER=
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Keep LLM_TIMEOUT_MS + TRANSLATE_TIMEOUT_MS below the web client's 45 s timeout.
LLM_TIMEOUT_MS=20000

# --- Embeddings ---
# local = multilingual-e5-small via transformers.js (no key, ~120 MB download on first run)
# gemini = gemini-embedding-001 (requires GEMINI_API_KEY; set EMBEDDING_DIM to match and re-embed: npm run kb:embed + kb:load)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=384

# --- Knowledge base (v2, built by knowledge/pipeline) ---
# pgvector (default when DATABASE_URL is set) | files (reads knowledge/processing/, no database needed)
KB_SOURCE=
# Example for docker-compose: postgresql://localnorm:localnorm@localhost:5433/localnorm
DATABASE_URL=
# TLS (Supabase): off | require (encrypted, not verified) | verify (needs DATABASE_SSL_CA).
# Default: verify when DATABASE_SSL_CA is set, require for *.supabase.com hosts, otherwise per the URL.
DATABASE_SSL=
# Path to the CA certificate, or the PEM text itself (e.g. in Vercel env)
DATABASE_SSL_CA=
KB_PROCESSING_DIR=knowledge/processing

# --- Question translation for cross-lingual retrieval ---
# local = OPUS-MT EN<->ID via transformers.js (~100 MB per direction, downloaded on first use)
# llm = the configured SumoPod model (default on Vercel when SUMOPOD_API_KEY is set; falls back to glossary on error)
# glossary = domain glossary terms only | none
QUERY_TRANSLATOR=local
TRANSLATE_TIMEOUT_MS=5000

# --- Retrieval tuning (calibrated for multilingual-e5-small; see docs/AI_IMPLEMENTATION.md) ---
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.80
RETRIEVAL_STRONG_SCORE=0.84
RETRIEVAL_STANDALONE_SCORE=0.86

# --- Frontend (web/.env) ---
# Leave empty in local dev (Vite proxies /api). In production set to the backend URL.
VITE_API_BASE_URL=
